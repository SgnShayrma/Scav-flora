<?xml version="1.0" ?>
<Defs>

<ThingDef ParentName="CavePlantBase">
    <defName>SGNGeotreewild</defName>
    <label>Wild Geotree</label>
	<description>Geotrees are not actually trees, but they got their name because of their resemblance to trees. Sweet fruits grows under its weirdly geometrical leaf-looking foliage.	</description>
	<statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Beauty>2</Beauty>
      <BeautyOutdoors>2</BeautyOutdoors>
      <Nutrition>0.5</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Geotree</texPath>
	  <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <pathCost>30</pathCost>
    <ingestible />
    <plant>
      <fertilityMin>0.01</fertilityMin>
      <fertilitySensitivity>0.15</fertilitySensitivity>
      <growDays>20</growDays>
      <dieIfLeafless>false</dieIfLeafless>
      <harvestYield>2</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>SGNGeofruit</harvestedThingDef>
      <neverBlightable>true</neverBlightable>
      <visualSizeRange>0.8~1.5</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <cavePlantWeight>0.35</cavePlantWeight>
      <purpose>Food</purpose>
      <pollution>Any</pollution>
    </plant>
</ThingDef>

