<?xml version="1.0" ?>
<Defs>
<ThingDef ParentName="PlantFoodRawBase">
    <defName>SGNGeofruit</defName>
    <label>Geofruit</label>
    <description>Geofruits are small, pear-shaped blue fruit that grows on geo-trees. Low in calories and decays fast.</description>
    <graphicData>
      <texPath>Berries/SGNGeofruit</texPath>
    </graphicData>
    <statBases>
	<Nutrition>0.25</Nutrition>
      <MarketValue>5</MarketValue>
      <Mass>0.6</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>14</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>RawTasty</preferability>
      <tasteThought></tasteThought>
      <foodType>VegetableOrFruit</foodType>
    </ingestible>
  </ThingDef>
  
    <ThingDef ParentName="ResourceBase">
    <defName>SGNBiochemFluid</defName>
    <label>Bio-chem Fluid</label>
    <description>Advanced chemical compound that greatly promotes chemical reactions and is able to mend certain materials together, or even melt them. Very commonly used in crafting.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <texPath>SGNBiochemFluid</texPath>
	        <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>300</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>3</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0.7</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>
  
   <ThingDef ParentName="RoughPlantBase">
    <defName>SGNNumberry</defName>
    <label>Numberry</label>
    <description>Numberry is a purplish-blue piece of plant tissue that can be obtained from a hydreed. It has a dissatisfying taste and texture and is presumably as mushy as the rest of the plant is, has an odd weight-absorbing property and an off-putting taste. Seems to have trace opiate concentration.</description>
    <graphicData>
      <texPath>Berries/SGNNumberry</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1.6</MarketValue>
      <Flammability>1.3</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>15</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>PlantMatter</li>
    </thingCategories>
    <ingestible>
      <preferability>DesperateOnly</preferability>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
    </ingestible>
  </ThingDef>
  
</Defs>