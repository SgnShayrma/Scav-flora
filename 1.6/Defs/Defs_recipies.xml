        <filter>
          <thingDefs>
            <li>SGNBiochemFluid</li>
          </thingDefs>
        </filter>
        <count>120</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SGNBiochemFluid</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Neutroamine>12</Neutroamine>
